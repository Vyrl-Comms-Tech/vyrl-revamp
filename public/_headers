# Next.js static export emits hashed, content-addressed filenames under
# /_next/static/ — safe to cache forever since a new build always gets new
# filenames.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Video
/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Images
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# 3D / environment assets
/*.glb
  Cache-Control: public, max-age=31536000, immutable
/*.hdr
  Cache-Control: public, max-age=31536000, immutable
